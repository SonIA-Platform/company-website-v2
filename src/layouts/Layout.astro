---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
}

const { title, description = 'SonIA ayuda a equipos de selección a priorizar grandes volúmenes de CVs según los requisitos de cada oferta y preparar una shortlist accionable.', canonical } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<slot />
	</body>
</html>
