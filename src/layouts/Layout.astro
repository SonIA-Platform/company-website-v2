---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
}

const { title, description = 'SonIA ayuda a equipos de selección a priorizar grandes volúmenes de CVs según los requisitos de cada oferta y preparar una shortlist accionable.', canonical } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon.ico" />
		<script is:inline>
			(() => {
				try {
					const savedTheme = localStorage.getItem('sonia-theme');
					const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					document.documentElement.dataset.theme = savedTheme || systemTheme;
				} catch {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<slot />
	</body>
</html>
