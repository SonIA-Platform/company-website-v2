---
import Layout from './Layout.astro';
import Footer from '@/sections/Footer.astro';

interface Props {
  title: string;
  description: string;
  updatedAt?: string;
}

const { title, description, updatedAt } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<Layout title={`${title} | SonIA`} description={description} canonical={canonical}>
  <header class="legal-header">
    <div class="container legal-nav">
      <a class="legal-brand" href="/" aria-label="SonIA, volver al inicio">
        <img src="/logo.png" width="1466" height="638" alt="SonIA" />
      </a>
    </div>
  </header>

  <main class="legal-main" id="contenido">
    <div class="container legal-shell">
      <header class="legal-title">
        <p class="eyebrow">Información legal</p>
        <h1>{title}</h1>
        {updatedAt && <p class="updated">Última actualización: {updatedAt}.</p>}
      </header>
      <article class="legal-content prose prose-lg prose-sonia max-w-none">
        <slot />
      </article>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .legal-header {
    background: var(--purple-900);
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }

  .legal-nav {
    align-items: center;
    display: flex;
    min-height: 76px;
  }

  .legal-brand {
    border-radius: var(--radius-md);
    display: block;
    overflow: hidden;
  }

  .legal-brand img {
    display: block;
    height: 42px;
    object-fit: contain;
    width: auto;
  }

  .legal-main {
    background: var(--paper);
    padding-block: clamp(var(--space-12), 8vw, var(--space-20));
  }

  .legal-shell {
    display: grid;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    grid-template-columns: minmax(240px, 0.62fr) minmax(0, 1.38fr);
  }

  .legal-title {
    align-self: start;
    display: grid;
    gap: var(--space-4);
    position: sticky;
    top: var(--space-8);
  }

  .legal-title h1 {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    line-height: var(--leading-tight);
  }

  .updated {
    color: var(--fg3);
    font-size: var(--text-sm);
  }

  .legal-content {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    padding: clamp(var(--space-6), 5vw, var(--space-12));
  }

  .legal-content :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-content :global(a) {
    overflow-wrap: anywhere;
  }

  .legal-content :global(.legal-data) {
    background: var(--purple-50);
    border: 1px solid var(--purple-100);
    border-radius: var(--radius-lg);
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-5);
    padding: var(--space-5);
  }

  .legal-content :global(.legal-data p) {
    margin: 0;
  }

  .legal-content :global(.legal-note) {
    background: var(--gold-50);
    border-left: 4px solid var(--gold-400);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-4) var(--space-5);
  }

  @media (max-width: 780px) {
    .legal-shell {
      grid-template-columns: 1fr;
    }

    .legal-title {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .legal-nav {
      padding-block: var(--space-4);
    }

    .legal-content {
      padding: var(--space-5);
    }
  }
</style>
