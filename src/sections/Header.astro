<header class="site-header">
  <div class="container header-inner">
    <a class="brand animate-blurred-fade-in animate-duration-slower" href="/" aria-label="SonIA, inicio">
      <img src="/logo.png" width="1466" height="638" alt="SonIA" />
    </a>
    <nav class="nav" aria-label="Principal">
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#beneficios">Beneficios</a>
      <a href="#producto">Producto</a>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Activar modo oscuro" aria-pressed="false">
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg>
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" /></svg>
    </button>
    <a class="button button-primary header-cta" href="#contacto">Solicitar una demo</a>
  </div>
</header>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

  const updateThemeToggle = () => {
    if (!themeToggle) return;
    const isDark = document.documentElement.dataset.theme === 'dark';
    themeToggle.setAttribute('aria-pressed', String(isDark));
    themeToggle.setAttribute('aria-label', isDark ? 'Activar modo claro' : 'Activar modo oscuro');
  };

  updateThemeToggle();

  themeToggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem('sonia-theme', nextTheme);
    updateThemeToggle();
  });
</script>

<style>
  .site-header {
    background: var(--paper);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(255 255 255 / 70%) inset;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    align-items: center;
    display: flex;
    gap: var(--space-6);
    justify-content: flex-start;
    min-height: 76px;
  }

  .brand {
    align-items: center;
    border-radius: var(--radius-md);
    display: inline-flex;
    overflow: hidden;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand img {
    display: block;
    height: 42px;
    object-fit: contain;
    width: auto;
  }

  .nav {
    align-items: center;
    display: flex;
    gap: var(--space-5);
    margin-left: var(--space-2);
  }

  .nav a {
    color: var(--fg2);
    font-size: var(--text-sm);
    font-weight: 700;
    position: relative;
    transition: color var(--dur) var(--ease);
  }

  .nav a::after {
    background: var(--gold-400);
    border-radius: var(--radius-full);
    bottom: -8px;
    content: "";
    height: 2px;
    left: 0;
    position: absolute;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
    width: 100%;
  }

  .nav a:hover {
    color: var(--purple-700);
    text-decoration: none;
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  .theme-toggle {
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--purple-700);
    cursor: pointer;
    display: inline-flex;
    flex: 0 0 auto;
    height: 42px;
    justify-content: center;
    margin-left: auto;
    padding: 0;
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease), transform var(--dur) var(--ease);
    width: 42px;
  }

  .theme-toggle:hover {
    background: var(--purple-50);
    border-color: var(--purple-300);
    transform: translateY(-1px);
  }

  .theme-icon {
    fill: none;
    height: 19px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    width: 19px;
  }

  .theme-icon-sun {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-icon-moon {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-icon-sun {
    display: block;
  }

  :global(html[data-theme="dark"]) .site-header {
    background: var(--paper);
    box-shadow: 0 1px 0 rgb(255 255 255 / 7%) inset;
  }

  :global(html[data-theme="dark"]) .nav a:hover {
    color: var(--purple-300);
  }

  @media (max-width: 760px) {
    .header-inner {
      flex-wrap: wrap;
      gap: var(--space-4);
      padding-block: var(--space-4);
    }

    .nav {
      order: 3;
      overflow-x: auto;
      width: 100%;
    }

    .header-cta {
      margin-left: 0;
      padding-inline: var(--space-4);
    }
  }

  @media (min-width: 761px) {
    .header-cta {
      margin-left: 0;
    }
  }
</style>
