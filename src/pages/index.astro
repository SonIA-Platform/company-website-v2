---
import Layout from '@/layouts/Layout.astro'

import Hero from '@/sections/Hero.astro'
import Footer from '@/sections/Footer.astro'
import Header from '@/sections/Header.astro'
import Process from '@/sections/Process.astro'
import Benefits from '@/sections/Benefits.astro'
import ProductPreview from '@/sections/ProductPreview.astro'
import FinalCta from '@/sections/FinalCta.astro'
---

<Layout
  title="SonIA | Ranking explicable de candidatos para selección de volumen"
  description="SonIA ayuda a equipos de selección a priorizar grandes volúmenes de CVs según los requisitos de cada oferta, entender el ranking y preparar un ranking accionable."
>
  <Header />
  <main id="contenido">
    <Hero />
    <Process />
    <Benefits />
    <ProductPreview />
    <FinalCta />
  </main>
  <Footer />
</Layout>
